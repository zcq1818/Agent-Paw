{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Paw",
  "version": "0.2.2",
  "identifier": "com.paw.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "create": false,
        "title": "Paw",
        "width": 340,
        "height": 340,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "x": 1500,
        "y": 680,
        "visible": true
      },
      {
        "label": "main",
        "create": false,
        "title": "Paw - 工作台",
        "width": 1040,
        "height": 720,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "center": true
      },
      {
        "label": "squad",
        "create": false,
        "title": "Paw 团队",
        "width": 520,
        "height": 210,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "launcher",
        "create": false,
        "title": "Paw 启动器",
        "width": 680,
        "height": 72,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2OTQ5OTgxNjAzNDYyRDAKUldUUVlqUmdnWm1VWmpFV2JiZFZRamdSOFVIRG9KclZoSkM4YzloVEdBQ3dJaGFhSnFNa2grUnYK",
      "endpoints": [
        "https://github.com/zcq1818/Agent-Paw/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
